{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "yaml",
      "camelcase": "Yaml",
      "title": "YAML",
      "scope": "source.yaml",
      "file-types": [
        "yaml",
        "yml",
        "clang-format",
        "clang-tidy",
        "gemrc",
        "CITATION.cff"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(yaml|yml)$",
      "class-name": "TreeSitterYaml",
      "folds": "queries/folds.scm"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "YAML grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
