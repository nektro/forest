{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bash",
      "camelcase": "Bash",
      "title": "Bash",
      "scope": "source.bash",
      "file-types": [
        "sh",
        "bash",
        "bashrc",
        "bash_profile",
        "bash_login",
        "bash_logout",
        "bash_aliases",
        "PKGBUILD",
        "APKBUILD",
        "ebuild",
        "eclass"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^(bash|sh|shell|shellscript)$",
      "class-name": "TreeSitterBash"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Bash grammar for tree-sitter, without an external scanner",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
