{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "css",
      "camelcase": "Css",
      "title": "CSS",
      "scope": "source.css",
      "file-types": [
        "css"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^css$",
      "class-name": "TreeSitterCss"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "CSS grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/OWNER/arborist"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
