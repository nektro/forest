{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "make",
      "camelcase": "Make",
      "title": "Makefile (GNU make)",
      "scope": "source.make",
      "file-types": [
        "mk",
        "mak",
        "make",
        "gmk",
        "Makefile",
        "makefile",
        "GNUmakefile",
        "Kbuild"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^(make|makefile|gmake|mk)$",
      "class-name": "TreeSitterMake"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "GNU Makefile grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
