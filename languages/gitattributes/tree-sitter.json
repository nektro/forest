{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gitattributes",
      "camelcase": "Gitattributes",
      "title": "gitattributes",
      "scope": "source.gitattributes",
      "file-types": [
        ".gitattributes",
        "gitattributes"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^gitattributes$",
      "class-name": "TreeSitterGitattributes"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "gitattributes grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/arborist"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
