# Let git decide which files are text, and check them out with LF.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.{bat,[bB][aA][tT]} text eol=crlf
*.cmd                text eol=crlf

# Binary files: no diffs, no merges, no line-ending conversion.
*.png  binary
*.jpg  binary
*.wasm binary

# Macros bundle attributes under one name.
[attr]generated linguist-generated=true -diff
src/parser.c      generated
src/*.json        generated
src/tree_sitter/* generated

# Language-aware diff hunks.
*.[ch]  diff=cpp
*.py    diff=python
*.md    diff=markdown whitespace=-blank-at-eol

# Keep tests and tooling out of `git archive`.
/test/**         export-ignore
/.github/        export-ignore
"docs/old notes" export-ignore

# Store large assets with Git LFS.
assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
