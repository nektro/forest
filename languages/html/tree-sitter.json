{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "html",
      "camelcase": "Html",
      "title": "HTML",
      "scope": "text.html.basic",
      "file-types": [
        "html",
        "htm",
        "shtml"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^html?$",
      "class-name": "TreeSitterHtml"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "HTML grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
