{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "batch",
      "camelcase": "Batch",
      "title": "Batch",
      "scope": "source.batch",
      "file-types": [
        "bat",
        "cmd",
        "btm",
        "BAT",
        "CMD"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^(batch|bat|cmd|dosbatch|winbatch)$",
      "class-name": "TreeSitterBatch"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Windows batch (cmd.exe) grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
