From 3f2a9c1d8e7b6a5f4e3d2c1b0a9f8e7d6c5b4a39 Mon Sep 17 00:00:00 2001
From: Ada Example <ada@example.com>
Date: Sat, 14 Nov 2026 09:12:44 -0800
Subject: [PATCH] greet: say hello by name

Read the name from the command line and fall back to "world".
---
 src/greet.c     | 9 ++++++---
 docs/logo.png   | Bin 1204 -> 1311 bytes
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/greet.c b/src/greet.c
index 4b1d2e0..a93c7f5 100644
--- a/src/greet.c
+++ b/src/greet.c
@@ -1,9 +1,12 @@
 #include <stdio.h>
 
-int main(void)
+int main(int argc, char **argv)
 {
-    printf("hello, world\n");
+    const char *name = argc > 1 ? argv[1] : "world";
+
+    printf("hello, %s\n", name);
     return 0;
 }
-// TODO: take a name
+
\ No newline at end of file
diff --git a/docs/logo.png b/docs/logo.png
index 7e0c3a1..b52f9d8 100644
Binary files a/docs/logo.png and b/docs/logo.png differ
diff --git a/README b/README.md
similarity index 88%
rename from README
rename to README.md
index 1c2d3e4..5f6a7b8 100644
--- a/README
+++ b/README.md
@@ -1,3 +1,3 @@
-greet
-=====
+# greet
+
 Says hello.
