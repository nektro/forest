{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "diff",
      "camelcase": "Diff",
      "title": "Diff",
      "scope": "source.diff",
      "file-types": [
        "diff",
        "patch",
        "debdiff",
        "rej"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(diff|patch|udiff)$",
      "class-name": "TreeSitterDiff"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Diff and patch grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/arborist"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
