{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "json",
      "camelcase": "Json",
      "title": "JSON",
      "scope": "source.json",
      "file-types": [
        "json",
        "jsonc",
        "jsonl"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^jsonc?$",
      "class-name": "TreeSitterJson"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "JSON (and JSONC) grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/OWNER/arborist"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
