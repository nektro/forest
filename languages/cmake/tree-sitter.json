{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cmake",
      "camelcase": "Cmake",
      "title": "CMake",
      "scope": "source.cmake",
      "file-types": [
        "cmake",
        "CMakeLists.txt"
      ],
      "injection-regex": "^cmake$",
      "class-name": "TreeSitterCmake"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "CMake grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/arborist"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
