            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_misc"
              },
              {
                "type": "SYMBOL",
                "name": "doctype"
              },
              {
                "type": "SYMBOL",
                "name": "element"
              },
              {
                "type": "SYMBOL",
                "name": "_markup_declaration"
              },
              {
                "type": "SYMBOL",
                "name": "conditional_section"
              }
            ]
          }
        }
      ]
    },
    "_misc": {
