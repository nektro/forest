{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "verilog",
      "camelcase": "Verilog",
      "title": "Verilog",
      "scope": "source.verilog",
      "file-types": [
        "v",
        "vh"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(verilog|v)$",
      "class-name": "TreeSitterVerilog",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Verilog (IEEE 1364-2005) grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
