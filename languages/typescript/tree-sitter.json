{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "typescript",
      "camelcase": "TypeScript",
      "title": "TypeScript",
      "scope": "source.ts",
      "file-types": [
        "ts",
        "mts",
        "cts",
        "tsx"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^(ts|tsx|typescript)$",
      "class-name": "TreeSitterTypeScript"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "TypeScript (with JSX) grammar for tree-sitter, without an external scanner",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
