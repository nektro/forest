// A terminal layout, in KDL 1.0: bare `true` and `false`, and `r"…"` raw strings.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
    }
    tab name="editor" focus=true {
        pane split_direction="vertical" {
            pane command="hx" size="70%"
            pane {
                pane command="cargo" {
                    args "watch" "-x" "test"
                }
                pane cwd=r"C:\Users\dev\logs"
            }
        }
    }
}
pane_frames false
mouse_mode true
