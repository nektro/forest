{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "kdl",
      "camelcase": "Kdl",
      "title": "KDL",
      "scope": "source.kdl",
      "file-types": [
        "kdl"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^kdl$",
      "class-name": "TreeSitterKdl"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "KDL grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/nektro/forest"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
