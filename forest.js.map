laration)\n  (struct_declaration)\n  (enum_declaration)\n  (union_declaration)\n  (opaque_declaration)\n  (if_statement)\n  (if_expression)\n  (for_statement)\n  (for_expression)\n  (while_statement)\n  (while_expression)\n  (switch_case)\n] @local.scope\n\n; Definitions\n; -----------\n\n(variable_declaration\n  name: (identifier) @local.definition.var)\n\n(function_declaration\n  name: (identifier) @local.definition.function)\n\n(parameter\n  name: (identifier) @local.definition.parameter)\n\n(payload\n  (identifier) @local.definition.var)\n\n(pointer_capture\n  (identifier) @local.definition.var)\n\n(container_field\n  name: (identifier) @local.definition.field)\n\n; References\n; ----------\n\n(identifier) @local.reference\n","tags":"(function_declaration\n  name: (identifier) @name) @definition.function\n\n(test_declaration\n  name: (_) @name) @definition.test\n\n(variable_declaration\n  name: (identifier) @name\n  value: [\n    (struct_declaration)\n    (union_declaration)\n    (opaque_declaration)\n  ]) @definition.class\n\n(variable_declaration\n  name: (identifier) @name\n  value: (enum_declaration)) @definition.enum\n\n(variable_declaration\n  name: (identifier) @name\n  value: (error_set_type)) @definition.type\n\n(container_field\n  name: (identifier) @name) @definition.field\n\n(call_expression\n  function: [\n    (identifier) @name\n    (field_expression\n      member: (identifier) @name)\n  ]) @reference.call\n","folds":"[\n  (block)\n  (struct_declaration)\n  (enum_declaration)\n  (union_declaration)\n  (opaque_declaration)\n  (error_set_type)\n  (switch_expression)\n  (initializer_list)\n  (parameters)\n  (arguments)\n  (asm_expression)\n  (multiline_string)\n] @fold\n"}}};