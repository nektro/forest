er) @tag)\n\n(jsx_self_closing_element\n  name: (identifier) @tag)\n\n; Capitalized names are components.\n(jsx_opening_element\n  name: (identifier) @type\n  (#match? @type \"^[A-Z]\"))\n\n(jsx_closing_element\n  name: (identifier) @type\n  (#match? @type \"^[A-Z]\"))\n\n(jsx_self_closing_element\n  name: (identifier) @type\n  (#match? @type \"^[A-Z]\"))\n\n(jsx_opening_element\n  name: (member_expression\n    property: (property_identifier) @type))\n\n(jsx_closing_element\n  name: (member_expression\n    property: (property_identifier) @type))\n\n(jsx_self_closing_element\n  name: (member_expression\n    property: (property_identifier) @type))\n\n(jsx_namespace_name\n  (identifier) @tag)\n\n(jsx_attribute\n  (property_identifier) @tag.attribute)\n\n(jsx_attribute\n  (jsx_namespace_name\n    (identifier) @tag.attribute))\n\n(html_character_reference) @string.special\n\n(jsx_opening_element\n  [\n    \"<\"\n    \">\"\n  ] @tag.delimiter)\n\n(jsx_closing_element\n  [\n    \"<\"\n    \"/\"\n    \">\"\n  ] @tag.delimiter)\n\n(jsx_self_closing_element\n  [\n    \"<\"\n    \"/\"\n    \">\"\n  ] @tag.delimiter)\n\n(jsx_expression\n  [\n    \"{\"\n    \"}\"\n  ] @punctuation.special)\n","injections":"((comment) @injection.content\n  (#set! injection.language \"comment\"))\n\n((regex_pattern) @injection.content\n  (#set! injection.language \"regex\"))\n\n; Tagged templates: html`...`, css`...`, sql`...`, graphql`...`\n(call_expression\n  function: (identifier) @injection.language\n  arguments: (template_string) @injection.content\n  (#any-of? @injection.language \"html\" \"css\" \"sql\" \"graphql\")\n  (#set! injection.include-children))\n\n(call_expression\n  function: (identifier) @_name\n  arguments: (template_string) @injection.content\n  (#eq? @_name \"gql\")\n  (#set! injection.language \"graphql\")\n  (#set! injection.include-children))\n","locals":"; Scopes\n; ------\n\n[\n  (program)\n  (statement_block)\n  (function_declaration)\n  (function_expression)\n  (genera