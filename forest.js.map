variable_name) @variable.builtin)\n  (#match? @variable.builtin \"^[@<^+?*%|][DF]?$\"))\n\n(function_name) @function.builtin\n\n; The function `$(call ...)` calls.\n(function_call\n  function: (function_name) @_call\n  .\n  argument: (text) @function.call\n  (#eq? @_call \"call\"))\n\n(escape_sequence) @string.escape\n\n(string) @string\n\n(vpath_directive\n  [\n    pattern: (word)\n    directory: (word)\n  ] @string.special.path)\n\n(include_directive\n  path: (word) @string.special.path)\n\n(load_directive\n  path: (word) @string.special.path)\n\n; Operators and punctuation\n; -------------------------\n\n(variable_assignment\n  operator: _ @operator)\n\n(define_directive\n  operator: _ @operator)\n\n(rule\n  operator: _ @punctuation.delimiter)\n\n(target_variable\n  [\n    \":\"\n    \"::\"\n  ] @punctuation.delimiter)\n\n[\n  \";\"\n  \"|\"\n] @punctuation.delimiter\n\n(rule\n  \":\" @punctuation.delimiter)\n\n(variable_reference\n  [\n    \":\"\n    \"=\"\n  ] @operator)\n\n[\n  \"(\"\n  \")\"\n  \"{\"\n  \"}\"\n] @punctuation.bracket\n\n\",\"  @punctuation.delimiter\n\n[\n  \"$(\"\n  \"${\"\n  \"$$(\"\n  \"$${\"\n] @punctuation.special\n\n(variable_reference\n  [\n    \")\"\n    \"}\"\n  ] @punctuation.special)\n\n(function_call\n  [\n    \")\"\n    \"}\"\n  ] @punctuation.special)\n","injections":"((comment) @injection.content\n  (#set! injection.language \"comment\"))\n\n; Each recipe line is run by the shell on its own. References, `$$` and the\n; `@`/`-`/`+` prefix are left out of the injected text.\n((recipe_line) @injection.content\n  (#set! injection.language \"bash\"))\n\n; $(shell command) and NAME != command\n((function_call\n  function: (function_name) @_function\n  argument: (text) @injection.content)\n  (#eq? @_function \"shell\")\n  (#set! injection.language \"bash\"))\n\n((variable_assignment\n  operator: \"!=\"\n  value: (text) @injection.content)\n  (#set! injection.language \"bash\"))\n","tags":"; Targets, variables and defines a makefile def